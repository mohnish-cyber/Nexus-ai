# ============================================================================
# NEXUS configuration. Copy to `.env` (repo root) or `backend/.env`.
# Every value is optional: NEXUS starts without any of them and tells you what
# is missing. API keys can also be entered in the app (Settings → API keys),
# where they are stored encrypted. Never put secrets in frontend/.env.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NEXUS_ENV=development            # development | production
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
LOG_LEVEL=INFO
# Where the SQLite database, uploads and backups live (default: backend/data)
# NEXUS_DATA_DIR=
# Encrypts API keys saved from the Settings page. REQUIRED in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEXUS_SECRET_KEY=
# Timezone used when the user hasn't set one (default: this computer's timezone)
# DEFAULT_TIMEZONE=Asia/Kolkata

# --- Database ------------------------------------------------------------------
# Default: SQLite in NEXUS_DATA_DIR. For Supabase use the "Direct connection"
# or pooler string from Project Settings → Database, e.g.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# and apply supabase/migrations/*.sql (enables Row Level Security).
# DATABASE_URL=

# --- Authentication --------------------------------------------------------------
# local:    single user on your own machine (default)
# supabase: multi-user; users sign in with Supabase Auth
AUTH_MODE=local
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=               # public anon key (sent to the browser; it is not a secret)
# SUPABASE_JWT_SECRET=             # legacy HS256 JWT secret; omit to verify with the project's JWKS
# NEXUS_ADMIN_EMAILS=you@example.com   # may edit API keys / host settings in supabase mode

# --- HTTP security -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=240
MAX_UPLOAD_MB=25

# --- AI core -----------------------------------------------------------------------
# anthropic (Claude) | openai_compatible (Ollama, LM Studio, vLLM...) | mock (dev only, clearly labelled)
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5
AI_EFFORT_DEFAULT=medium          # low | medium | high | xhigh | max
AI_EFFORT_ROUTING=low             # effort for internal planning / memory extraction
ANTHROPIC_REFUSAL_FALLBACK=true   # server-side fallback model if a request is declined
AI_MAX_OUTPUT_TOKENS=16000
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=llama3.1
# OPENAI_COMPAT_API_KEY=

# --- Web search (ResearchAgent) ----------------------------------------------------
SEARCH_PROVIDER=auto              # auto | tavily | brave | searxng
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SEARXNG_URL=http://localhost:8888

# --- Voice ----------------------------------------------------------------------------
# Speech-to-text: auto uses OpenAI Whisper if a key is set, else local faster-whisper
# if installed (pip install -e ".[local-stt]"), else the browser's recognition.
STT_PROVIDER=auto                 # auto | openai | local | none
# OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
LOCAL_WHISPER_MODEL=base
# Text-to-speech: browser voices by default; server voices need a key.
TTS_PROVIDER=browser              # browser | openai | elevenlabs
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# --- Computer control / workspace -------------------------------------------------------
# Defaults to on in local mode and OFF in supabase mode (remote users must never
# control the server machine). Only enable on your own computer.
# COMPUTER_CONTROL_ENABLED=true
# Folders NEXUS may read and (with approval) modify, comma-separated.
# More can be added in Settings → Workspace folders.
# WORKSPACE_ROOTS=~/projects,~/college

# --- Background jobs -------------------------------------------------------------------
# embedded: scheduler runs inside the API process (default, simplest)
# external: run `python -m app.worker` separately (recommended for production)
SCHEDULER_MODE=embedded
SCHEDULER_POLL_SECONDS=20
